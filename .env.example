NTULEARN_USERNAME=your_ntu_email_or_username
NTULEARN_PASSWORD=your_password

# Keep false for the first run so you can complete MFA/manual prompts.
HEADLESS=false
SLOW_MO_MS=100
WAIT_AFTER_LOGIN_SECONDS=10

# 0 means keep refreshing until found. Set to e.g. 120 to stop after 120 checks.
MAX_CHECK_ATTEMPTS=0

ATTENDANCE_TIMEZONE=Asia/Singapore
ATTENDANCE_DAY=thursday
ATTENDANCE_START=10:30
ATTENDANCE_END=11:30

NTULEARN_MODULE_NAME=26S1-SC3040-ADVANCED SOFTWARE ENGINEERING
# Optional fallback if Blackboard exposes the module link as javascript:void(0).
# Example: https://ntulearn.ntu.edu.sg/ultra/courses/_2712409_1/outline
NTULEARN_MODULE_URL=
NTULEARN_ATTENDANCE_FOLDER_NAME=Tutorial Attendance
NTULEARN_ATTENDANCE_RECORDS_NAME=Tutorial attendance records
